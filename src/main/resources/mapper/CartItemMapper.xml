<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.campussecondhandapi.mapper.CartItemMapper">
    
    <resultMap id="BaseResultMap" type="com.campus.campussecondhandapi.entity.CartItem">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="quantity" property="quantity"/>
        <association property="product" javaType="com.campus.campussecondhandapi.entity.Product">
            <id column="product_id" property="id"/>
            <result column="product_name" property="name"/>
            <result column="price" property="price"/>
            <result column="image" property="image"/>
        </association>
    </resultMap>
    
    <select id="selectByUserId" resultType="com.campus.campussecondhandapi.entity.CartItem">
        SELECT c.*
        FROM cart c
        WHERE c.user_id = #{userId}
    </select>
    
    <select id="selectByUserIdAndProductId" resultType="com.campus.campussecondhandapi.entity.CartItem">
        SELECT * FROM cart
        WHERE user_id = #{userId} AND product_id = #{productId}
    </select>
    
    <insert id="insert" parameterType="com.campus.campussecondhandapi.entity.CartItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cart (user_id, product_id, quantity)
        VALUES (#{userId}, #{productId}, #{quantity})
    </insert>
    
    <update id="updateQuantity">
        UPDATE cart 
        SET quantity = #{quantity}
        WHERE user_id = #{userId} AND product_id = #{productId}
    </update>
    
    <delete id="deleteByUserIdAndProductId">
        DELETE FROM cart
        WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>
    
    <delete id="deleteByUserId">
        DELETE FROM cart WHERE user_id = #{userId}
    </delete>
    
</mapper>
