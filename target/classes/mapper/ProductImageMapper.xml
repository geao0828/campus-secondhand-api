<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.campussecondhandapi.mapper.ProductImageMapper">
    
    <select id="selectByProductId" resultType="com.campus.campussecondhandapi.entity.ProductImage">
        SELECT * FROM product_image
        WHERE product_id = #{productId}
        ORDER BY sort ASC
    </select>
    
    <insert id="insert" parameterType="com.campus.campussecondhandapi.entity.ProductImage" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_image (product_id, url, sort)
        VALUES (#{productId}, #{url}, #{sort})
    </insert>
    
    <insert id="insertBatch">
        INSERT INTO product_image (product_id, url, sort)
        VALUES
        <foreach collection="list" item="image" separator=",">
            (#{image.productId}, #{image.url}, #{image.sort})
        </foreach>
    </insert>
    
    <delete id="deleteByProductId">
        DELETE FROM product_image WHERE product_id = #{productId}
    </delete>
    
</mapper>
